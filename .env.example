# Copy this file to .env and fill in your values. Everything is optional —
# the app runs fully in "dev mode" without any of these.

# Data storage: required. All app data (users, products, orders, etc.) lives
# in Postgres — see db/schema.sql for the schema and db/import.js for a
# one-time import script. Provision a Postgres database from the Vercel
# Storage tab (Neon-backed) and it injects this automatically; copy the same
# connection string here for local development.
DATABASE_URL=

# Image uploads (admin dashboard "Add photos"): without this set, uploads
# save straight to public/img/products/, which works locally but NOT on
# Vercel (same read-only-filesystem issue as above). For a Vercel
# deployment, add a Blob store from the Storage tab in your project — it
# injects BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=

# Free SMTP email delivery via a Gmail account + App Password (no paid
# service required). Without these set, emails are logged to the console
# and OTP codes are shown in the UI instead.
# Setup: Google Account -> Security -> 2-Step Verification (enable it) ->
# App Passwords -> create one for "Mail" -> paste the 16-character code below.
SMTP_USER=your.gmail.address@gmail.com
SMTP_PASS=your16charapppassword

# The "from" address used for outgoing email (usually the same as SMTP_USER).
EMAIL_FROM=Beautique <your.gmail.address@gmail.com>

# Invite code required to create an admin account from the sign-up form.
ADMIN_INVITE_CODE=BEAUTIQUE-ADMIN

# Server port (defaults to 3000).
PORT=3000

# Google sign-in (console.cloud.google.com -> APIs & Services -> Identifiants
# -> Créer des identifiants -> ID client OAuth). Without these set, the
# "Sign in with Google" button won't work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Card payments via Stripe Checkout. Without this set, "Pay online" is
# rejected at checkout and customers should use "Pay on delivery" instead.
# Setup: dashboard.stripe.com -> Developers -> API keys -> Secret key.
# Use a test-mode key (starts with sk_test_) for a working demo with no real
# money moving (card 4242 4242 4242 4242, any future date/CVC); switch to a
# live key (sk_live_) only once you're ready to accept real payments.
STRIPE_SECRET_KEY=

# Admin dashboard "Store assistant" (Claude) — answers analytics questions
# (best sellers, ratings, revenue, low stock) from your live data. Without
# this set, the assistant tab shows a "not set up yet" message; everything
# else in the app is unaffected.
# Setup: console.anthropic.com -> API Keys -> Create Key.
ANTHROPIC_API_KEY=
